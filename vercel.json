{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|sw\\.js|manifest\\.json|icon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?type=morning",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron?type=evening",
      "schedule": "0 15 * * *"
    }
  ]
}
